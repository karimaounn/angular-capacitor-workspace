import { setCompodocJson } from '@storybook/addon-docs/angular';
import type { Preview } from '@storybook/angular';
import docJson from '../documentation.json';

// The design tokens are *not* imported here. @storybook/angular's webpack
// config handles .scss the way Angular needs it for component styles — through
// sass-loader to a raw string, with no css-loader — so a global stylesheet
// imported from this file reaches webpack's JavaScript parser and dies on the
// first `@layer`. Instead `styles:tokens` compiles the sheet to
// `.storybook/static/tokens.css` and `preview-head.html` links it.

/**
 * Compodoc argument resolution.
 *
 * Storybook cannot read Angular decorator metadata at runtime, so without this
 * the controls panel falls back to guessing types from the values in `args` —
 * which turns every enum into a free-text box and loses every TSDoc comment.
 * Compodoc extracts the real types and docs at build time; `setCompodocJson`
 * hands them to Storybook.
 *
 * `documentation.json` is generated by `npm run docs:compodoc`, which the
 * `storybook` and `build-storybook` scripts run first. It is gitignored — it is
 * build output, and a checked-in copy goes stale silently.
 */
setCompodocJson(docJson);

const preview: Preview = {
  parameters: {
    controls: {
      matchers: {
        color: /(background|color)$/i,
        date: /Date$/i,
      },
    },

    backgrounds: { disable: true },
  },

  // The theme toggle drives the same attribute the tokens key off, so a story
  // viewed in dark mode is rendered by exactly the mechanism production uses.
  globalTypes: {
    theme: {
      description: 'Colour scheme',
      defaultValue: 'light',
      toolbar: {
        icon: 'circlehollow',
        items: [
          { value: 'light', title: 'Light' },
          { value: 'dark', title: 'Dark' },
        ],
        dynamicTitle: true,
      },
    },
  },

  decorators: [
    (story, context) => {
      document.documentElement.setAttribute('data-theme', context.globals['theme'] as string);
      return story();
    },
  ],
};

export default preview;
