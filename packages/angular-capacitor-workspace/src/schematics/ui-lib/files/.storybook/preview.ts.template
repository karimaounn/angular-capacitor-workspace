import { DocsContainer, type DocsContainerProps } from '@storybook/addon-docs/blocks';
import type { Preview } from '@storybook/angular-vite';
import { themes } from 'storybook/theming';

// The design tokens are not imported here: the Storybook targets in
// angular.json load them as a global stylesheet, the same way an application's
// build does.
//
// Nor is there a documentation step. Storybook cannot read Angular decorator
// metadata at runtime, and without help the controls panel guesses types from
// the values in `args` — every enum a free-text box, every TSDoc comment lost.
// @storybook/angular-vite extracts the real input types and their TSDoc from
// the component sources at build time, so there is nothing to generate first
// and nothing to go stale.

/** The toolbar's `theme` global, with `system` resolved against the OS. */
function isDark(theme: unknown): boolean {
  if (theme === 'dark' || theme === 'light') {
    return theme === 'dark';
  }
  return window.matchMedia('(prefers-color-scheme: dark)').matches;
}

/**
 * The docs page in the scheme the toolbar has chosen.
 *
 * Docs pages take one static theme, light unless told otherwise, so a dark
 * component would otherwise be documented on a white page. Storybook re-renders
 * the docs page when a global changes, which is when this reads the new value.
 *
 * `DocsContainer` is called rather than rendered as an element: creating one
 * needs React, which is Storybook's dependency and not this workspace's.
 */
function ThemedDocsContainer(props: DocsContainerProps) {
  let theme: unknown;
  try {
    theme = props.context.getStoryContext(props.context.storyById())['globals']['theme'];
  } catch {
    // An MDX page attached to no component has no story to read globals from.
  }
  return DocsContainer({ ...props, theme: isDark(theme) ? themes.dark : themes.light });
}

const preview: Preview = {
  parameters: {
    controls: {
      matchers: {
        color: /(background|color)$/i,
        date: /Date$/i,
      },
    },

    backgrounds: { disable: true },

    docs: { container: ThemedDocsContainer },
  },

  // Both toolbars drive the same two attributes the tokens key off — the two
  // `ThemeService` writes in an application with theme switching — so a story
  // viewed in dark mode, or in another palette, is rendered by exactly the
  // mechanism production uses rather than by a Storybook-only approximation. The colour
  // scheme also themes Storybook itself: the docs page through the container
  // above, the manager through `manager.ts`.
  //
  // `system` is the default, as it is for `ThemeService`, and is expressed the
  // same way: by removing `data-theme` so the stylesheet's
  // `prefers-color-scheme` block governs.
  //
  // The palette list is repeated here rather than read from `_ref.scss`, or
  // from `theme.ts` where theme switching adds one: the Storybook config is
  // loaded outside the Angular compilation. `check:contrast` compares
  // `theme.ts` against the stylesheet, and this list is checked by eye against
  // the same place.
  globalTypes: {
    theme: {
      description: 'Colour scheme',
      defaultValue: 'system',
      toolbar: {
        icon: 'circlehollow',
        items: [
          { value: 'system', title: 'System' },
          { value: 'light', title: 'Light' },
          { value: 'dark', title: 'Dark' },
        ],
        dynamicTitle: true,
      },
    },
    palette: {
      description: 'Palette',
      defaultValue: 'default',
      toolbar: {
        icon: 'paintbrush',
        items: [
          { value: 'default', title: 'Slate' },
          { value: 'sand', title: 'Sand' },
          { value: 'indigo', title: 'Indigo' },
        ],
        dynamicTitle: true,
      },
    },
  },

  decorators: [
    (story, context) => {
      const root = document.documentElement;
      const theme = context.globals['theme'] as string;
      if (theme === 'light' || theme === 'dark') {
        root.setAttribute('data-theme', theme);
      } else {
        root.removeAttribute('data-theme');
      }
      root.setAttribute('data-palette', context.globals['palette'] as string);
      return story();
    },
  ],
};

export default preview;
