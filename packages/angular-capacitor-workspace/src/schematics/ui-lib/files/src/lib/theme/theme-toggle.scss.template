@use '../../styles/components' as c;

@layer components {
  :host {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  // A segmented control: one radio group, drawn as a row of pills.
  .modes {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: var(--space-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background: var(--surface-sunken);
  }

  legend {
    @include c.visually-hidden;
  }

  .modes label {
    display: inline-flex;
    align-items: center;
    padding-inline: var(--space-3);
    min-block-size: 32px;
    border-radius: var(--radius-full);
    color: var(--text-muted);
    font-size: var(--font-size-sm);
    cursor: pointer;

    @include c.transition(background-color, color);

    // The ring belongs on the label, because the input itself is off-screen.
    // `:focus-within` is what carries it there.
    &:has(:focus-visible) {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    &:has(:checked) {
      background: var(--surface-raised);
      color: var(--text);
      box-shadow: 0 1px 2px rgb(0 0 0 / 12%);
    }
  }

  // Off-screen rather than `display: none`, which would take the radios out of
  // the accessibility tree and the tab order along with them.
  .modes input {
    @include c.visually-hidden;
  }

  .palette {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-muted);
    font-size: var(--font-size-sm);
  }

  select {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    color: var(--text);
    font: inherit;
    font-size: var(--font-size-sm);

    @include c.focus-ring;
  }
}
