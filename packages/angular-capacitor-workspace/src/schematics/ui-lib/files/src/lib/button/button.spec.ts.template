import { ComponentFixture, TestBed } from '@angular/core/testing';
import { beforeEach, describe, expect, it, vi } from 'vitest';
import { Button } from './button';

/**
 * These run in a real browser engine, not jsdom — see the `browsers` option on
 * this project's `test` target. That matters for a component library: focus
 * behaviour, `:focus-visible`, computed styles and layout are exactly the
 * things jsdom stubs out, and exactly the things a design system gets wrong.
 */
describe('Button', () => {
  let fixture: ComponentFixture<Button>;

  beforeEach(async () => {
    await TestBed.configureTestingModule({ imports: [Button] }).compileComponents();
    fixture = TestBed.createComponent(Button);
  });

  it('renders a native button, defaulting to type="button"', () => {
    fixture.detectChanges();

    const button = fixture.nativeElement.querySelector('button') as HTMLButtonElement;
    expect(button).toBeTruthy();
    // Defaulting to `submit` inside a form is a classic accidental-submit bug.
    expect(button.type).toBe('button');
  });

  it('emits on activation', () => {
    const activated = vi.fn();
    fixture.componentInstance.activated.subscribe(activated);
    fixture.detectChanges();

    fixture.nativeElement.querySelector('button').click();

    expect(activated).toHaveBeenCalledTimes(1);
  });

  it('swallows clicks while loading without being disabled', () => {
    const activated = vi.fn();
    fixture.componentInstance.activated.subscribe(activated);
    fixture.componentRef.setInput('loading', true);
    fixture.detectChanges();

    const button = fixture.nativeElement.querySelector('button') as HTMLButtonElement;
    button.click();

    expect(activated).not.toHaveBeenCalled();
    // Still focusable and still announced — `aria-busy`, not `disabled`.
    expect(button.disabled).toBe(false);
    expect(button.getAttribute('aria-busy')).toBe('true');
  });

  it('is focusable by keyboard', () => {
    fixture.detectChanges();

    const button = fixture.nativeElement.querySelector('button') as HTMLButtonElement;
    button.focus();

    expect(document.activeElement).toBe(button);
  });
});
