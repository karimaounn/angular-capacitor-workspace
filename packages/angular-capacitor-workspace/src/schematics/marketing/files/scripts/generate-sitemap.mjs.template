#!/usr/bin/env node
// ─────────────────────────────────────────────────────────────────────────────
// Writes sitemap.xml for a prerendered app, from its build output.
//
// The prerender output is already the authoritative list of pages, so the
// sitemap is derived from it rather than maintained by hand — the two cannot
// drift. Each page contributes its own canonical URL; a page marked noindex
// (the 404) is left out. Runs as postbuild:<app>, before verify-prerender.mjs,
// which checks that the result matches.
//
//   node scripts/generate-sitemap.mjs <app>
// ─────────────────────────────────────────────────────────────────────────────
import fs from 'node:fs';
import path from 'node:path';

import { browserDir, inspect, isNoindex, pages } from './prerendered.mjs';

const dir = browserDir('generate-sitemap.mjs');

const escapeXml = (s) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

const urls = [];
for (const page of pages(dir)) {
  const head = inspect(fs.readFileSync(page.file, 'utf8'));
  if (isNoindex(head)) continue;
  // A page with no canonical is left out rather than failing here, so the
  // build reaches verify-prerender.mjs, which reports it together with every
  // other problem instead of one at a time.
  const [canonical] = head.canonicals;
  if (canonical) urls.push(canonical);
}

const xml = [
  '<?xml version="1.0" encoding="UTF-8"?>',
  '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">',
  ...urls.map((url) => `  <url><loc>${escapeXml(url)}</loc></url>`),
  '</urlset>',
  '',
].join('\n');

fs.writeFileSync(path.join(dir, 'sitemap.xml'), xml);
console.log(`generate-sitemap: ${urls.length} URLs → sitemap.xml`);
