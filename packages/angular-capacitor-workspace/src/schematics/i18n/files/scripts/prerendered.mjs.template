// ─────────────────────────────────────────────────────────────────────────────
// Shared by the postbuild scripts of a prerendered app: where its output is,
// which files are pages, and what each page's <head> says about itself.
//
// Reading our own build output, not arbitrary HTML — Angular's serializer
// writes attributes in a stable, double-quoted form — so a regex is enough and
// no parser dependency is needed.
//
// LOCALES. A site generated with `--i18n` is built once per language, each into
// its own directory, so `outputs()` returns one entry per language instead of
// one for the site. A site without it returns a single entry whose locale is
// null, and every caller writes the same code for both.
// ─────────────────────────────────────────────────────────────────────────────
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const ROOT = path.join(path.dirname(fileURLToPath(import.meta.url)), '..');

/** The locales passed as `--locales en,fr`, or an empty array. */
export function localesFromArgv() {
  const flag = process.argv.indexOf('--locales');
  if (flag === -1) {
    return [];
  }
  return (process.argv[flag + 1] ?? '')
    .split(',')
    .map((tag) => tag.trim())
    .filter(Boolean);
}

/** The app name, or exits with usage. */
function appFromArgv(script) {
  const app = process.argv[2];
  if (!app || app.startsWith('--')) {
    console.error(`usage: node scripts/${script} <app> [--locales en,fr]`);
    process.exit(2);
  }
  return app;
}

/**
 * Every built output to check: `{ locale, dir, base }`.
 *
 * `base` is the path each output is served under — `/` for a single-language
 * site, `/fr` for one language of a localized one — and is what turns a file's
 * position on disk into the URL a crawler will ask for.
 */
export function outputs(script) {
  const app = appFromArgv(script);
  const locales = localesFromArgv();
  const root = path.join(ROOT, 'dist', app);

  const found = locales.length
    ? locales.map((locale) => ({
        locale,
        dir: path.join(root, locale),
        base: `/${locale}`,
      }))
    : [{ locale: null, dir: path.join(root, 'browser'), base: '' }];

  const missing = found.filter((output) => !fs.existsSync(output.dir));
  if (missing.length) {
    for (const output of missing) {
      console.error(`${script}: ${path.relative(ROOT, output.dir)} does not exist.`);
    }
    console.error(`${script}: build ${app} first.`);
    process.exit(2);
  }

  return { app, root, outputs: found };
}

/**
 * Every prerendered page in one output: each `index.html` under it, with the
 * site path it is served at. `index.csr.html` is the client-rendering fallback,
 * not a page, and is skipped by name.
 */
export function pages(output) {
  return fs
    .readdirSync(output.dir, { recursive: true })
    .filter((file) => path.basename(file) === 'index.html')
    .map((file) => {
      const rel = path.dirname(file).split(path.sep).join('/');
      const route = rel === '.' ? '/' : `/${rel}`;
      return {
        file: path.join(output.dir, file),
        /** The route within the app, the same in every language. */
        route,
        /** The path it is actually served at, locale prefix and all. */
        path: output.base ? `${output.base}${route === '/' ? '/' : route}` : route,
        locale: output.locale,
      };
    })
    .sort((a, b) => a.path.localeCompare(b.path));
}

const decode = (value) =>
  value
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&amp;/g, '&');

function attributes(tag) {
  const attrs = {};
  for (const [, name, value] of tag.matchAll(/([\w:-]+)(?:="([^"]*)")?/g)) {
    attrs[name] = value === undefined ? '' : decode(value);
  }
  return attrs;
}

/** The parts of a page the SEO checks care about. */
export function inspect(html) {
  const head = html.slice(0, html.indexOf('</head>'));
  const tags = (name) =>
    [...head.matchAll(new RegExp(`<${name}\\b[^>]*>`, 'g'))].map((m) => attributes(m[0]));

  const metas = tags('meta');
  const meta = (key, value) => metas.filter((m) => m[key] === value).map((m) => m.content);
  const links = tags('link');

  return {
    html: attributes(html.match(/<html\b[^>]*>/)?.[0] ?? ''),
    titles: [...head.matchAll(/<title>([^<]*)<\/title>/g)].map((m) => decode(m[1])),
    descriptions: meta('name', 'description'),
    robots: meta('name', 'robots'),
    canonicals: links.filter((l) => l.rel === 'canonical').map((l) => l.href),
    alternates: links
      .filter((l) => l.rel === 'alternate' && l.hreflang)
      .map((l) => ({ hreflang: l.hreflang, href: l.href })),
    h1Count: [...html.matchAll(/<h1[\s>]/g)].length,
  };
}

export const isNoindex = (page) => page.robots.some((r) => /\bnoindex\b/.test(r));
