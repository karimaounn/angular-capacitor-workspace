// Logical properties throughout — this is the one component guaranteed to be on
// screen when the writing direction flips. See styles/_direction.scss.
:host {
  display: inline-block;
}

label {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
}

.label {
  color: var(--text-muted);
  font-size: var(--font-size-sm);
}

select {
  padding-block: var(--space-1);
  padding-inline: var(--space-2);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background: var(--surface-raised);
  color: var(--text);
  font: inherit;
}
