<!-- `lang` on each option so a screen reader pronounces every endonym in its
     own language rather than reading العربية with an English voice. -->
<label>
  <span class="label">Language</span>
  <!-- `selected` on each option, not `value` on the select: the select's own
       property bindings are applied before the @for block has created any
       options, so a bound `value` would be assigned against an empty list. See
       the palette picker in theme-toggle. -->
  <select (change)="select($event)" (pointerdown)="preload($event)">
    @for (locale of locales; track locale) {
      <option [value]="locale" [attr.lang]="locale" [selected]="locale === i18n.locale()">
        {{ labels[locale] }}
      </option>
    }
  </select>
</label>
