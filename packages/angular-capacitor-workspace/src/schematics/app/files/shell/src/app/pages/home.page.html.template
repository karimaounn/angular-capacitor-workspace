<h1><%= title %></h1>

<p class="lead">
  Generated by <code>angular-capacitor-workspace</code>. Everything below is drawn from
  <code><%= libName %></code>'s design tokens — the controls in the header rewrite two
  attributes on <code>&lt;html&gt;</code>, and the whole page follows without a re-render.
</p>

<section aria-labelledby="tokens-heading" class="card">
  <h2 id="tokens-heading">Tokens</h2>
  <p>
    Colour scheme <strong>{{ theme.resolvedMode() }}</strong>, palette
    <strong>{{ paletteLabel() }}</strong>.
    @if (theme.mode() === 'system') {
      <span class="muted">Following your system — pick Light or Dark to override it.</span>
    }
  </p>

  <ul class="swatches">
    @for (swatch of swatches; track swatch.token) {
      <li
        [style.background]="'var(' + swatch.token + ')'"
        [style.color]="'var(' + swatch.on + ')'"
      >
        {{ swatch.label }}
      </li>
    }
  </ul>

  <p class="muted">
    Every pairing above is checked against WCAG, in both modes and every palette, by
    <code>npm run check:contrast</code>.
  </p>
</section>

<section aria-labelledby="components-heading" class="card">
  <h2 id="components-heading">Components</h2>

  <div class="row">
    <<%= libPrefix %>-button [loading]="submitting()" (activated)="submit()">
      Primary
    </<%= libPrefix %>-button>
    <<%= libPrefix %>-button variant="secondary">Secondary</<%= libPrefix %>-button>
    <<%= libPrefix %>-button variant="ghost">Ghost</<%= libPrefix %>-button>
    <<%= libPrefix %>-button variant="danger">Danger</<%= libPrefix %>-button>
    <<%= libPrefix %>-button [disabled]="true">Disabled</<%= libPrefix %>-button>
  </div>

  <<%= libPrefix %>-field
    label="Email address"
    type="email"
    placeholder="you@example.com"
    hint="Type something without an @ to see the error state."
    [(value)]="email"
    [error]="emailError()"
  />

  <p class="muted">
    Both live in <code>projects/<%= libName %>/src/lib/</code>, with stories in Storybook
    (<code>npm run storybook</code>) and tests that run in a real browser engine.
  </p>
</section>

<section aria-labelledby="next-heading" class="card">
  <h2 id="next-heading">Next</h2>
  <ul class="next">
    <li>Replace this page: <code>src/app/pages/home.page.ts</code>.</li>
    <li>House rules for this workspace: <code>AGENTS.md</code>.</li>
    <li>Every script, with a line on each: <code>README.md</code>.</li>
    <li>Add a palette: <code>projects/<%= libName %>/src/styles/_ref.scss</code>.</li>
  </ul>
</section>
