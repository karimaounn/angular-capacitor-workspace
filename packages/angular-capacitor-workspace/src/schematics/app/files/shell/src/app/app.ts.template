import { ChangeDetectionStrategy, Component, signal } from '@angular/core';
import { RouterOutlet } from '@angular/router';
import { ThemeToggle } from '<%= libName %>';

/**
 * The application shell: the frame every route shares.
 *
 * It holds the theme toggle and nothing else that a page would want to own.
 * The `<h1>` belongs to the page, not to the shell — a shell heading makes
 * every page in the app claim the same title to a screen reader.
 */
@Component({
  selector: '<%= prefix %>-root',
  imports: [RouterOutlet, ThemeToggle],
  templateUrl: './app.html',
  styleUrl: './app.scss',
  changeDetection: ChangeDetectionStrategy.OnPush,
})
export class App {
  protected readonly title = signal('<%= title %>');
}
