import { ChangeDetectionStrategy, Component, inject } from '@angular/core';
import { LOCALES, LOCALE_LABELS, TranslationService, isLocale } from './i18n';

/**
 * The language picker.
 *
 * A native `<select>`, for the reason the palette picker in `theme-toggle` is
 * one: on a phone it opens the OS picker, and this library ships inside a
 * Capacitor app where that matters more than it does on the web.
 *
 * Its own accessible name is the one string in this library that is NOT
 * translated, and deliberately: a visitor looking for their language cannot
 * necessarily read the locale that is active. `LOCALE_LABELS` holds endonyms
 * for the same reason — "Arabic" is useless to a reader who needs العربية.
 *
 * `preload` on pointer-down rather than on change: each catalog is a lazy
 * chunk, so fetching while the list is still open hides the round trip behind
 * the gesture. It fetches every locale, because at pointer-down the select
 * still holds the active one and nothing yet says which option the finger will
 * land on. Catalogs are small, and opening the picker is a reader saying they
 * are about to switch. A switch whose catalog has not arrived renders the
 * fallback locale for an instant, which is correct but visible.
 */
@Component({
  selector: '<%= prefix %>-language-picker',
  changeDetection: ChangeDetectionStrategy.OnPush,
  templateUrl: './language-picker.html',
  styleUrl: './language-picker.scss',
})
export class LanguagePicker {
  protected readonly i18n = inject(TranslationService);
  protected readonly locales = LOCALES;
  protected readonly labels = LOCALE_LABELS;

  protected select(event: Event): void {
    const value = (event.target as HTMLSelectElement).value;
    if (isLocale(value)) {
      this.i18n.setLocale(value);
    }
  }

  protected preload(): void {
    for (const locale of LOCALES) {
      void this.i18n.preload(locale);
    }
  }
}
