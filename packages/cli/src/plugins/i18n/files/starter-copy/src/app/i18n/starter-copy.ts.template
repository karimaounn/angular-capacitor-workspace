// Generated by angular-capacitor-workspace, and rewritten on every run of
// `ng generate @angular-capacitor-workspace/cli:i18n`. The words are in the
// catalogs, under `starter.`; this only reads them. Goes with the starter page.
import { computed, inject, type Signal } from '@angular/core';
import { TranslationService } from '<%= importName %>';
import { STARTER_TEXT, type StarterCopy } from '../pages/starter-copy';
import type { MessageKey } from './messages';

/**
 * The starter page's text in the active locale, provided as `STARTER_COPY` in
 * `app.config.ts`. A computed signal, so the page follows the language picker.
 */
export function translatedStarterCopy(): Signal<StarterCopy> {
  const i18n = inject(TranslationService);
  const fields = Object.keys(STARTER_TEXT) as (keyof StarterCopy)[];
  return computed(() => {
    const copy: Partial<Record<keyof StarterCopy, string>> = {};
    for (const field of fields) {
      // Typed, so a field the page has and the source catalog lacks is a
      // compile error here rather than `starter.lead` on screen.
      const key: MessageKey = `starter.${field}`;
      copy[field] = i18n.translate(key);
    }
    return copy as StarterCopy;
  });
}
