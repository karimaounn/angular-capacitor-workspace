import { ChangeDetectionStrategy, Component, inject, signal, viewChild } from '@angular/core';
import { ActivatedRoute, Router, RouterLink } from '@angular/router';
import { AuthAction, Button, PasswordAuthService } from '<%= importName %>';
import { NewPassword } from './new-password';

/**
 * Resetting a forgotten password: ask for a code, then use it to set a new
 * password. Ends at sign-in, since a reset does not sign anyone in.
 */
@Component({
  selector: '<%= prefix %>-reset-password-page',
  imports: [RouterLink, Button, NewPassword],
  templateUrl: './reset-password.page.html',
  styleUrls: ['./auth-page.scss', './auth-form.scss'],
  changeDetection: ChangeDetectionStrategy.OnPush,
})
export class ResetPasswordPage {
  private readonly auth = inject(PasswordAuthService);
  private readonly router = inject(Router);

  protected readonly step = signal<'request' | 'reset'>('request');
  protected readonly email = signal(
    inject(ActivatedRoute).snapshot.queryParamMap.get('email') ?? '',
  );
  protected readonly code = signal('');
  protected readonly password = signal('');

  protected readonly action = new AuthAction();
  private readonly chosen = viewChild(NewPassword);

  protected request(event?: Event): void {
    event?.preventDefault();
    this.action.run(this.auth.forgotPassword(this.email()), ({ destination }) => {
      this.step.set('reset');
      this.action.notice.set(`We sent a code to ${destination ?? 'your email address'}.`);
    });
  }

  protected reset(event: Event): void {
    event.preventDefault();
    if (!this.chosen()?.valid()) {
      return;
    }
    this.action.run(
      this.auth.confirmForgotPassword(this.email(), this.code().trim(), this.password()),
      () =>
        void this.router.navigate(['/auth/sign-in'], {
          queryParams: { email: this.email(), notice: 'reset' },
        }),
    );
  }
}
