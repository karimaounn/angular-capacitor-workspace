<div class="stack">
  <div class="field">
    <label [for]="id">{{ label() }}</label>
    <input
      #box
      [id]="id"
      type="password"
      autocomplete="new-password"
      required
      [value]="password()"
      [attr.aria-invalid]="failures().length > 0 ? 'true' : null"
      [attr.aria-describedby]="id + '-rules'"
      (input)="password.set(box.value)"
    />
    <ul class="hint" [id]="id + '-rules'" [class.invalid]="failures().length > 0">
      @for (rule of failures().length > 0 ? failures() : rules; track rule) {
        <li>{{ rule }}</li>
      }
    </ul>
  </div>

  <div class="field">
    <label [for]="id + '-repeat'">Repeat it</label>
    <input
      #again
      [id]="id + '-repeat'"
      type="password"
      autocomplete="new-password"
      required
      [value]="repeat()"
      [attr.aria-invalid]="mismatch() ? 'true' : null"
      [attr.aria-describedby]="mismatch() ? id + '-mismatch' : null"
      (input)="repeat.set(again.value)"
    />
    @if (mismatch()) {
      <p class="hint invalid" [id]="id + '-mismatch'">The two passwords do not match.</p>
    }
  </div>
</div>
