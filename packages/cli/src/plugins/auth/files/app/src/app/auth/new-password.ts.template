import {
  ChangeDetectionStrategy,
  Component,
  computed,
  inject,
  input,
  model,
  signal,
} from '@angular/core';
import { PASSWORD_POLICY, describePasswordPolicy, passwordPolicyErrors } from '<%= importName %>';

let nextId = 0;

/**
 * Choosing a password: the field, its repeat, and the policy's rules under it,
 * which turn into the ones the password breaks as it is typed.
 *
 * Every screen that sets a password uses this — signing up, resetting, the
 * challenge to replace a temporary one, changing it — so the policy is checked
 * the same way everywhere. The policy is `passwordPolicy` in the design
 * system's `src/config/auth.ts`.
 */
@Component({
  selector: '<%= prefix %>-new-password',
  templateUrl: './new-password.html',
  styleUrl: './auth-form.scss',
  host: { style: 'display: block' },
  changeDetection: ChangeDetectionStrategy.OnPush,
})
export class NewPassword {
  readonly label = input('Password');

  /** Two-way bound: `[(password)]="password"`. */
  readonly password = model('');

  protected readonly repeat = signal('');
  protected readonly id = `new-password-${nextId++}`;

  private readonly policy = inject(PASSWORD_POLICY);
  protected readonly rules = describePasswordPolicy(this.policy);

  protected readonly failures = computed(() =>
    this.password() === '' ? [] : passwordPolicyErrors(this.policy, this.password()),
  );

  protected readonly mismatch = computed(
    () => this.repeat() !== '' && this.repeat() !== this.password(),
  );

  /** Whether the password meets the policy and was typed the same twice. */
  readonly valid = computed(
    () =>
      this.password() !== '' && this.failures().length === 0 && this.repeat() === this.password(),
  );

  /** Empties both fields, once the password they chose has been saved. */
  clear(): void {
    this.password.set('');
    this.repeat.set('');
  }
}
