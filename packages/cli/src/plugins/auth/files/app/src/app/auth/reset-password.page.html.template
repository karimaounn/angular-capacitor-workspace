<h1>Reset your password</h1>

@if (step() === 'request') {
  <p class="lead">We will send a code to your email address. Use it to choose a new password.</p>

  <form (submit)="request($event)">
    <div class="field">
      <label for="reset-email">Email address</label>
      <input
        #emailBox
        id="reset-email"
        type="email"
        autocomplete="username"
        required
        [value]="email()"
        (input)="email.set(emailBox.value)"
      />
    </div>

    @if (action.error(); as error) {
      <p class="error" role="alert">{{ error.message }}</p>
    }
    <<%= libPrefix %>-button type="submit" [loading]="action.busy()">Send a code</<%= libPrefix %>-button>
  </form>
} @else {
  <form (submit)="reset($event)">
    @if (action.notice(); as notice) {
      <p class="notice" role="status">{{ notice }}</p>
    }

    <div class="field">
      <label for="reset-code">Code</label>
      <input
        #codeBox
        id="reset-code"
        inputmode="numeric"
        autocomplete="one-time-code"
        required
        [value]="code()"
        (input)="code.set(codeBox.value)"
      />
    </div>

    <<%= prefix %>-new-password label="New password" [(password)]="password" />

    @if (action.error(); as error) {
      <p class="error" role="alert">{{ error.message }}</p>
    }
    <<%= libPrefix %>-button type="submit" [loading]="action.busy()">Set password</<%= libPrefix %>-button>
    <button type="button" class="linkish" [disabled]="action.busy()" (click)="request()">
      Send a new code
    </button>
  </form>
}

<p class="links">
  <a routerLink="/auth/sign-in">Back to sign in</a>
</p>
