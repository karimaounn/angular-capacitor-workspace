<h1><%= title %></h1>

<p class="lead">{{ copy().lead }}</p>

<section aria-labelledby="tokens-heading" class="card">
  <h2 id="tokens-heading">{{ copy().tokensHeading }}</h2>

  <ul class="swatches">
    @for (swatch of swatches; track swatch.token) {
      <li
        [style.background]="'var(' + swatch.token + ')'"
        [style.color]="'var(' + swatch.on + ')'"
      >
        {{ swatch.label }}
      </li>
    }
  </ul>

  <p class="muted">{{ copy().tokensNote }} <code>npm run check:contrast</code></p>
</section>

<section aria-labelledby="components-heading" class="card">
  <h2 id="components-heading">{{ copy().componentsHeading }}</h2>

  <div class="row">
    <<%= libPrefix %>-button [loading]="submitting()" (activated)="submit()">
      {{ copy().primary }}
    </<%= libPrefix %>-button>
    <<%= libPrefix %>-button variant="secondary">{{ copy().secondary }}</<%= libPrefix %>-button>
    <<%= libPrefix %>-button variant="ghost">{{ copy().ghost }}</<%= libPrefix %>-button>
    <<%= libPrefix %>-button variant="danger">{{ copy().danger }}</<%= libPrefix %>-button>
    <<%= libPrefix %>-button [disabled]="true">{{ copy().disabled }}</<%= libPrefix %>-button>
  </div>

  <<%= libPrefix %>-field
    [label]="copy().emailLabel"
    type="email"
    placeholder="you@example.com"
    [hint]="copy().emailHint"
    [(value)]="email"
    [error]="emailError()"
  />

  <p class="muted">
    {{ copy().componentsSource }} <code>projects/<%= libName %>/src/lib/</code><br />
    {{ copy().componentsStories }} <code>npm run storybook</code>
  </p>
</section>

<section aria-labelledby="next-heading" class="card">
  <h2 id="next-heading">{{ copy().nextHeading }}</h2>
  <ul class="next">
    <li>{{ copy().nextReplace }} <code>src/app/pages/home.page.ts</code></li>
    <li>{{ copy().nextRules }} <code>AGENTS.md</code></li>
    <li>{{ copy().nextScripts }} <code>README.md</code></li>
    <li>{{ copy().nextPalette }} <code>projects/<%= libName %>/src/styles/_ref.scss</code></li>
  </ul>
</section>
