import { ChangeDetectionStrategy, Component, computed, inject, signal } from '@angular/core';
import { Button, Field } from '<%= libName %>';
import { STARTER_COPY } from './starter-copy';

/** One swatch in the token strip: a custom property and the text that sits on it. */
interface Swatch {
  readonly token: string;
  readonly on: string;
  readonly label: string;
}

/**
 * The starter screen.
 *
 * It is here to be deleted. What it is worth reading first is *what* it
 * demonstrates: every colour on this page is a custom property from
 * <%= libName %>, declared for light and dark in one stylesheet, so the page
 * follows the system colour scheme without a single component knowing there is
 * one.
 *
 * Plugins add sections of their own above the last one — theme switching and
 * translation each bring one. Its text is in `starter-copy.ts`, which the i18n
 * plugin translates. Replace the whole page with your own home route in
 * `app.routes.ts`.
 */
@Component({
  selector: '<%= prefix %>-home-page',
  imports: [Button, Field],
  templateUrl: './home.page.html',
  styleUrl: './home.page.scss',
  changeDetection: ChangeDetectionStrategy.OnPush,
})
export class HomePage {
  protected readonly copy = inject(STARTER_COPY);
  protected readonly email = signal('');
  protected readonly submitting = signal(false);

  /** Deliberately naive. A real form belongs to a form library, not to a starter page. */
  protected readonly emailError = computed(() => {
    const value = this.email();
    if (value.length === 0 || value.includes('@')) {
      return undefined;
    }
    return this.copy().emailError;
  });

  protected readonly swatches: readonly Swatch[] = [
    { token: '--surface-raised', on: '--text', label: 'surface-raised' },
    { token: '--surface-sunken', on: '--text', label: 'surface-sunken' },
    { token: '--accent', on: '--on-accent', label: 'accent' },
    { token: '--success', on: '--on-accent', label: 'success' },
    { token: '--warning', on: '--on-accent', label: 'warning' },
    { token: '--danger', on: '--on-accent', label: 'danger' },
  ];

  protected submit(): void {
    this.submitting.set(true);
    setTimeout(() => this.submitting.set(false), 900);
  }
}
