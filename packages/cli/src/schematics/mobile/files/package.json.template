{
  "name": "@<%= workspace %>/<%= app %>-mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Capacitor shell for the <%= app %> application.",
  "scripts": {
    "cap": "cap",
    "sync": "<%= buildWeb %> && cap sync",<% for (const platform of platforms) { %>
    "sync:<%= platform %>": "<%= buildWeb %> && cap sync <%= platform %>",
    "run:<%= platform %>": "<%= buildWeb %> && cap run <%= platform %>",
    "open:<%= platform %>": "cap open <%= platform %>",<% } %>
    "preflight": "angular-capacitor-workspace preflight <%= platforms.join(' ') %>",
    "doctor": "cap doctor"
  },
  "dependencies": {
    "@capacitor/core": "<%= versions['@capacitor/core'] %>"<% for (const platform of platforms) { %>,
    "@capacitor/<%= platform %>": "<%= versions['@capacitor/' + platform] %>"<% } %>
  },
  "devDependencies": {
    "@capacitor/cli": "<%= versions['@capacitor/cli'] %>"
  }
}
