{
  "name": "angular-capacitor-workspace-monorepo",
  "version": "22.6.0",
  "private": true,
  "description": "Monorepo for the angular-capacitor-workspace generator and its create bootstrap.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.8.0",
    "npm": ">=11.6.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo out-tsc",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b packages/cli packages/create --pretty && tsc -p packages/i18n --pretty && tsc -p packages/theming --pretty",
    "create": "node scripts/create-local.mjs",
    "e2e": "node e2e/matrix.mjs",
    "e2e:minimal": "node e2e/matrix.mjs --row minimal",
    "sweep": "node e2e/sweep.mjs",
    "bump": "node scripts/bump.mjs",
    "sync-versions": "node scripts/sync-versions.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@types/node": "^24.13.6",
    "jsdom": "^30.1.2",
    "ng-packagr": "^22.2.4",
    "prettier": "^3.9.8",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "esbuild": true
  }
}
